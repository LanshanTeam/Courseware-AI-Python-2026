# Obsidian 个人工作区配置（窗口布局、最近打开文件等），每次开关都会变，不进版本库
.obsidian/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/

# Lesson 配图生成脚本与运行产物（本地保留，不入库；配图资产在 lesson01/assets/）
lesson01/scripts/
lesson01/.ipynb_checkpoints/
lesson01/students.json
lesson01/students.txt
lesson02/scripts/
lesson02/.ipynb_checkpoints/
lesson02/data/
lesson02/bad.json

# 配图中间产物：脚本每次跑都会重生成 SVG 矢量稿，入库只留笔记本引用的 PNG/GIF
lesson01/assets/*.svg
lesson02/assets/*.svg

# AI 助手本地工作目录（记忆/会话数据，不入库）
.workbuddy-ai/
